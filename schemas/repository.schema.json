{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-github-study.local/schemas/repository.schema.json",
  "title": "RepositoryInfo",
  "description": "github-star-analyzer 가 생성하는 표준 Repository 모델",
  "type": "object",
  "$ref": "#/$defs/repositoryInfoFields",
  "unevaluatedProperties": false,
  "$defs": {
    "repositoryId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "stars": {
      "type": "integer",
      "minimum": 0
    },
    "repositoryInfoFields": {
      "type": "object",
      "required": [
        "repository",
        "url",
        "description",
        "stars",
        "previousStars",
        "delta24h",
        "firstSeen",
        "isNew"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repositoryId"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "stars": {
          "$ref": "#/$defs/stars"
        },
        "previousStars": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "delta24h": {
          "type": [
            "integer",
            "null"
          ]
        },
        "firstSeen": {
          "$ref": "#/$defs/isoDate"
        },
        "isNew": {
          "type": "boolean"
        }
      }
    },
    "observation": {
      "title": "RepositoryObservation",
      "description": "github-ai-discovery 출력 단위",
      "type": "object",
      "required": [
        "repository",
        "url",
        "description",
        "stars"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "$ref": "#/$defs/repositoryId"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "stars": {
          "$ref": "#/$defs/stars"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "pushedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "discoveryOutput": {
      "title": "DiscoveryOutput",
      "type": "object",
      "required": [
        "date",
        "repositories"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/isoDate"
        },
        "repositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    }
  }
}

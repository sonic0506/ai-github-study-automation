# ─────────────────────────────────────────────────────────────
# ai-github-study 환경변수 예시
# 사용법: cp .env.example .env  → 값 채우기
# .env 는 git 에 올라가지 않는다 (.gitignore)
# ─────────────────────────────────────────────────────────────

# ── GitHub API ───────────────────────────────────────────────
# Fine-grained Personal Access Token 권장
#   Settings → Developer settings → Fine-grained tokens → Generate new token
#   Repository access: "Public repositories (read-only)"  / 추가 권한 없음
# 비워 두면 비인증 호출 (검색 API 분당 10회, 일반 API 시간당 60회)
# ※ 셸에 이미 export 된 환경변수가 있으면 .env 값보다 우선한다 (echo $GITHUB_TOKEN 으로 확인)
GITHUB_TOKEN=

# 기본값을 바꿀 때만 주석 해제
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_API_VERSION=2022-11-28
# GITHUB_REQUEST_TIMEOUT_MS=15000
# GITHUB_MAX_RETRIES=3
# rate limit 해제까지 기다릴 최대 시간 (ms). 넘으면 실패
# GITHUB_MAX_RATE_LIMIT_WAIT_MS=90000

# ── 실행 환경 ────────────────────────────────────────────────
# 날짜 계산 기준 시간대
AGS_TIMEZONE=Asia/Seoul

# Snapshot / Registry 저장 위치 (프로젝트 루트 기준)
#   data              : 운영 데이터 (GitHub Actions 가 관리, git 추적)
#   output/local-data : 로컬 실험용 (git 제외) ← 로컬에서는 이 값 권장
AGS_DATA_DIR=output/local-data

# Study 초안 PR 이 올라가는 저장소 (owner/name). 열린 study/* PR 을 후보에서 제외할 때 조회.
# 비우면 GitHub Actions 의 GITHUB_REPOSITORY 를 쓰고, 둘 다 없으면 PR 확인을 건너뛴다 (studies/ 파일 확인은 항상 수행)
# AGS_STUDY_REPOSITORY=sonic0506/ai-github-study-automation

# ── 이후 Phase 에서 사용 (지금은 비워 둠) ────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
